# Copy to .env (gitignored) and adjust. Read by docker compose and by Spring Boot.
DB_URL=jdbc:postgresql://localhost:5432/bemock
DB_NAME=bemock
# Host port for docker compose; change it (and DB_URL) if 5432 is taken by a local PostgreSQL
DB_PORT=5432
DB_USERNAME=bemock
DB_PASSWORD=change-me
# JWT signing key, at least 32 bytes, e.g. generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-value-of-at-least-32-bytes
# Optional bootstrap admin (created at startup if both are set)
ADMIN_EMAIL=
ADMIN_PASSWORD=
